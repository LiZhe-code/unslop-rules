 "patterns": [
  {
   "id": "em_dash",
   "label": "Em-dash overuse",
   "regex": "—",
   "threshold_per_100_words": 1,
   "why": "LLMs lean on em-dashes for rhythm."
  },
  {
   "id": "not_x_but_y",
   "label": "\"It's not X, it's Y\"",
   "regex": "\\b(?:it's|it is|this is) not (?:just |only |merely )?[^.;,]{1,40}[,;] (?:it's|it is|but)\\b",
   "why": "Contrast framing that LLMs overuse."
  },
  {
   "id": "triplet",
   "label": "Rule-of-three lists",
   "regex": "\\b\\w+(?:ing|ity|ness|tion)?, \\w+(?:ing|ity|ness|tion)?,? and \\w+",
   "why": "Lists of exactly three for cadence."
  },
  {
   "id": "rhetorical_q",
   "label": "Rhetorical question opener",
   "regex": "(?:^|\\n)\\s*(?:Ever wondered|Have you ever wondered|Imagine)",
   "why": "Hook template."
  },
  {
   "id": "colon_reveal",
   "label": "Colon reveal",
   "regex": "\\bHere's the (?:thing|kicker|catch|truth):",
   "why": "Fake suspense."
  }
 ]
}